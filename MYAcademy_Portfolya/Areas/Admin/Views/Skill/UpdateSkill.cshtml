@model MYAcademy_Portfolya.Entites.Skill
@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var percent = Model != null && Model.Percentage > 0 ? Model.Percentage : 50;
}

@section Styles {
    <style>
        .form-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
        }

        .form-card-header {
            padding: 20px 26px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .form-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--pastel-purple);
            color: var(--primary-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .form-card-body {
            padding: 26px;
        }

        .form-card-footer {
            padding: 16px 26px;
            border-top: 1px solid var(--border-color);
            background: #FAFBFE;
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .form-label {
            font-size: 0.83rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

            .form-label .req {
                color: #c0342b;
            }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #DCE1ED;
            padding: 9px 13px;
            font-size: 0.88rem;
        }

        .input-icon-wrap {
            position: relative;
        }

            .input-icon-wrap i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-secondary);
                pointer-events: none;
            }

            .input-icon-wrap .form-control,
            .input-icon-wrap .form-select {
                padding-left: 38px;
            }

        .btn-accent {
            background: var(--primary-accent);
            border: 1px solid var(--primary-accent);
            color: #fff;
            border-radius: 12px;
            font-weight: 600;
            padding: 9px 20px;
            box-shadow: 0 4px 12px rgba(130, 118, 217, 0.25);
        }

            .btn-accent:hover {
                background: var(--primary-accent-hover);
                color: #fff;
            }

        .btn-soft {
            background: #fff;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 12px;
            font-weight: 500;
            padding: 9px 18px;
        }

            .btn-soft:hover {
                background: #F8F9FD;
                color: var(--primary-accent);
            }

        .field-validation-error {
            font-size: 0.78rem;
            color: #c0342b;
        }

        /* ===== Yüzde slider ===== */
        .percent-box {
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid #DCE1ED;
            border-radius: 10px;
            padding: 12px 16px;
        }

            .percent-box input[type=range] {
                flex: 1;
                width: 100%;
                accent-color: var(--primary-accent);
                cursor: pointer;
            }

        .percent-badge {
            min-width: 64px;
            text-align: center;
            font-weight: 700;
            color: var(--primary-accent);
            background: var(--pastel-purple);
            border-radius: 20px;
            padding: 4px 10px;
        }

        .percent-preview {
            height: 8px;
            background: var(--pastel-purple);
            border-radius: 10px;
            overflow: hidden;
        }

            .percent-preview div {
                height: 100%;
                background: var(--primary-accent);
                border-radius: 10px;
                transition: width .2s;
            }
    </style>
}

<div class="form-card">
    <form asp-area="Admin" asp-action="UpdateSkill" method="post">
        <input type="hidden" asp-for="SkillId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-lightning-charge"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Yetenek Güncelle</h5>
                <small class="text-secondary">Mevcut yetenek bilgilerini düzenleyip kaydedin.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div class="row g-4">

                <!-- Kategori -->
                <div class="col-md-6">
                    <label asp-for="SkillCategoryId" class="form-label">Kategori <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-collection"></i>
                        <select asp-for="SkillCategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                            <option value="">Kategori seçiniz...</option>
                        </select>
                    </div>
                    <span asp-validation-for="SkillCategoryId"></span>
                </div>

                <!-- Yetenek adı -->
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Yetenek Adı <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-check2-square"></i>
                        <input asp-for="Name" class="form-control" placeholder="Örn: ASP.NET Core" required />
                    </div>
                    <span asp-validation-for="Name"></span>
                </div>

                <!-- Yüzde (YENİ) -->
                <div class="col-12">
                    <label for="percentInput" class="form-label">Yetkinlik Seviyesi <span class="req">*</span></label>
                    <div class="percent-box">
                        <input type="range" name="Percentage" id="percentInput"
                               min="5" max="100" step="5" value="@percent" />
                        <span class="percent-badge"><span id="percentValue">@percent</span>%</span>
                    </div>
                    <div class="percent-preview mt-2">
                        <div id="percentBar" style="width:@(percent)%"></div>
                    </div>
                    <span asp-validation-for="Percentage"></span>
                </div>

            </div>
        </div>

        <div class="form-card-footer">
            <a asp-area="Admin" asp-action="SkillList" class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i> Vazgeç
            </a>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const percentInput = document.getElementById("percentInput");
        const percentValue = document.getElementById("percentValue");
        const percentBar = document.getElementById("percentBar");

        percentInput.addEventListener("input", () => {
            percentValue.textContent = percentInput.value;
            percentBar.style.width = percentInput.value + "%";
        });
    </script>
}