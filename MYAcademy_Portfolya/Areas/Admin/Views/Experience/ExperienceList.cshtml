@model List<MYAcademy_Portfolya.Entites.Experience>
@{
    ViewData["Title"] = "Deneyimler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@section Styles {
    <style>
        .list-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
        }

        .list-card-header {
            padding: 20px 26px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        .list-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--pastel-purple);
            color: var(--primary-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .exp-table th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--text-secondary);
            font-weight: 600;
            background: #F5F4F0;
            padding: 12px 16px;
        }

        .exp-table td {
            padding: 14px 16px;
            font-size: 0.88rem;
        }

        .btn-accent {
            background: var(--primary-accent);
            border: 1px solid var(--primary-accent);
            color: #fff;
            border-radius: 12px;
            font-weight: 600;
            padding: 9px 20px;
            box-shadow: 0 4px 12px rgba(40, 54, 24, 0.25);
        }

            .btn-accent:hover {
                background: var(--primary-accent-hover);
                color: #fff;
            }

        .btn-soft {
            background: #fff;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 10px;
        }

            .btn-soft:hover {
                background: #F5F4F0;
                color: var(--primary-accent);
            }

        .btn-soft-danger {
            background: #fff;
            border: 1px solid #F3C9C6;
            color: #c0342b;
            border-radius: 10px;
        }

            .btn-soft-danger:hover {
                background: #FDF1F0;
                color: #a32a22;
            }

        .status-badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 20px;
        }

        .status-active {
            background: #E6F6EC;
            color: #1E8449;
        }

        .status-done {
            background: #EEF0F5;
            color: #6B7280;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: var(--text-secondary);
        }
    </style>
}


<div class="list-card">
    <!-- BAŞLIK + EKLE BUTONU -->
    <div class="list-card-header">
        <div class="d-flex align-items-center gap-3">
            <div class="list-card-icon"><i class="bi bi-briefcase"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">İş Deneyimleri</h5>
                <small class="text-secondary">Toplam @Model.Count deneyim</small>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Experience" asp-action="CreateExperience" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i> Yeni Deneyim Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-briefcase fs-1 d-block mb-2"></i>
            Henüz deneyim eklenmedi.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table exp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Alt Başlık</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsActive ? "" : "opacity-75")">
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-secondary">@item.CompanyName</small>
                            </td>
                            <td>@item.SideTitle</td>
                            <td class="text-nowrap">
                                @item.Period
                                @if (item.EndDate == null)
                                {
                                    <div><small class="text-success"><i class="bi bi-circle-fill" style="font-size:.5rem;"></i> Halen çalışıyor</small></div>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-badge status-done">Pasif</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-area="Admin" asp-controller="Experience" asp-action="UpdateExperience"
                                   asp-route-id="@item.ExperienceId" class="btn btn-sm btn-soft">
                                    <i class="bi bi-pencil me-1"></i> Güncelle
                                </a>
                                <form asp-area="Admin" asp-controller="Experience" asp-action="DeleteExperience"
                                      asp-route-id="@item.ExperienceId" method="post" class="d-inline js-delete"
                                      data-message="&quot;@item.Title&quot; deneyimi silinecek.">
                                    <button type="submit" class="btn btn-sm btn-soft-danger">
                                        <i class="bi bi-trash me-1"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>