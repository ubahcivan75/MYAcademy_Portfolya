@model MYAcademy_Portfolya.Areas.Admin.Models.DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var tr = new CultureInfo("tr-TR");
    int activePercent = Model.ProjectCount > 0
        ? (int)Math.Round(Model.ActiveProjectCount * 100.0 / Model.ProjectCount) : 0;
    int maxCategory = Model.CategorySummaries.Any()
        ? Model.CategorySummaries.Max(x => x.ProjectCount) : 0;
}

@functions {
    // "Ahmet Yılmaz" → "AY"
    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var result = parts[0].Substring(0, 1);
        if (parts.Length > 1) result += parts[^1].Substring(0, 1);
        return result.ToUpper(new CultureInfo("tr-TR"));
    }
}

<style>
    .dash {
        color: #1f2937;
        padding: 8px 4px 24px;
    }

        .dash * {
            box-sizing: border-box;
        }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }

        .dash-header h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0;
        }

        .dash-header p {
            margin: 4px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    .dash-grid {
        display: grid;
        gap: 20px;
        margin-bottom: 20px;
    }

    .dash-stats {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .dash-two {
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    }

    .dash-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .dash-card h3 {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .dash-card h3 a {
                font-size: 13px;
                font-weight: 500;
                color: #4f46e5;
                text-decoration: none;
            }

    /* İstatistik kartları */
    .stat {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: inherit;
        transition: transform .15s, box-shadow .15s;
    }

        .stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,.06);
            color: inherit;
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        margin: 2px 0 0;
        line-height: 1.1;
    }

    .stat-sub {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 4px;
    }

    .stat-alert {
        border-color: #fcd34d;
        background: #fffdf5;
    }

    .bg-indigo {
        background: #eef2ff;
        color: #4f46e5;
    }

    .bg-green {
        background: #ecfdf5;
        color: #059669;
    }

    .bg-amber {
        background: #fffbeb;
        color: #d97706;
    }

    .bg-sky {
        background: #f0f9ff;
        color: #0284c7;
    }

    .bg-rose {
        background: #fff1f2;
        color: #e11d48;
    }

    .bg-violet {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .bg-teal {
        background: #f0fdfa;
        color: #0d9488;
    }

    /* Tablo */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .dash-table th {
            text-align: left;
            font-weight: 600;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            background: #f9fafb;
        }

        .dash-table td {
            padding: 12px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .dash-table tr:last-child td {
            border-bottom: none;
        }

        .dash-table tbody tr {
            cursor: pointer;
        }

            .dash-table tbody tr:hover td {
                background: #f5f7ff;
            }

        .dash-table tr.unread td {
            font-weight: 600;
        }

        .dash-table a {
            color: inherit;
            text-decoration: none;
        }

    .table-scroll {
        overflow-x: auto;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4338ca;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 13px;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .name-cell {
        display: flex;
        align-items: center;
    }

    .muted {
        color: #6b7280;
        font-size: 13px;
        font-weight: 400;
    }

    .pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
    }

    .pill-read, .pill-active {
        background: #ecfdf5;
        color: #047857;
    }

    .pill-unread {
        background: #fef3c7;
        color: #b45309;
    }

    .pill-passive {
        background: #f3f4f6;
        color: #6b7280;
    }

    /* Son projeler */
    .project-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .project-row:last-child {
            border-bottom: none;
        }

    .project-thumb {
        width: 64px;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 6px;
        background: #f3f4f6;
        flex-shrink: 0;
    }

    .project-info {
        flex: 1;
        min-width: 0;
    }

        .project-info .title {
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .edit-link {
        font-size: 13px;
        color: #4f46e5;
        text-decoration: none;
        white-space: nowrap;
    }

        .edit-link:hover {
            text-decoration: underline;
        }

    /* Kategori özeti */
    .cat-row {
        margin-bottom: 16px;
    }

        .cat-row:last-child {
            margin-bottom: 0;
        }

    .cat-top {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 6px;
    }

        .cat-top span:last-child {
            color: #6b7280;
        }

    .cat-track {
        height: 10px;
        background: #f3f4f6;
        border-radius: 99px;
        overflow: hidden;
    }

    .cat-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    /* Hızlı işlemler */
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
    }

        .quick-actions a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            color: #1f2937;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: border-color .15s, background .15s;
        }

            .quick-actions a:hover {
                border-color: #4f46e5;
                background: #f5f7ff;
            }

        .quick-actions .qa-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .quick-actions small {
            display: block;
            font-weight: 400;
            color: #6b7280;
            font-size: 12px;
        }

    .empty {
        text-align: center;
        color: #9ca3af;
        padding: 24px 0;
        font-size: 14px;
    }
</style>

<div class="dash">

    <!-- ================= BAŞLIK ================= -->
    <div class="dash-header">
        <div>
            <h1>Dashboard</h1>
            <p>Hoş geldiniz! Portfolyo sitenizin genel durumu aşağıda.</p>
        </div>
        <span class="muted">@DateTime.Now.ToString("dd MMMM yyyy, dddd", tr)</span>
    </div>

    <!-- ================= 1) İSTATİSTİK KARTLARI ================= -->
    <div class="dash-grid dash-stats">
        <a href="/Admin/Project/Index" class="dash-card stat">
            <div class="stat-icon bg-indigo"><i class="bi bi-kanban"></i></div>
            <div>
                <p class="stat-label">Toplam Proje</p>
                <p class="stat-value">@Model.ProjectCount</p>
                <div class="stat-sub">Admin panelindeki tüm projeler</div>
            </div>
        </a>

        <a href="/Admin/Project/Index" class="dash-card stat">
            <div class="stat-icon bg-green"><i class="bi bi-broadcast"></i></div>
            <div>
                <p class="stat-label">Aktif Proje</p>
                <p class="stat-value">@Model.ActiveProjectCount</p>
                <div class="stat-sub">%@activePercent'i sitede yayında</div>
            </div>
        </a>

        <a href="/Admin/Skill/SkillList" class="dash-card stat">
            <div class="stat-icon bg-violet"><i class="bi bi-lightning-charge"></i></div>
            <div>
                <p class="stat-label">Yetenek</p>
                <p class="stat-value">@Model.SkillCount</p>
                <div class="stat-sub">Tüm kategorilerde</div>
            </div>
        </a>

        <a href="/Admin/Experience/ExperienceList" class="dash-card stat">
            <div class="stat-icon bg-sky"><i class="bi bi-briefcase"></i></div>
            <div>
                <p class="stat-label">Deneyim</p>
                <p class="stat-value">@Model.ExperienceCount</p>
                <div class="stat-sub">İş deneyimi kaydı</div>
            </div>
        </a>

        <a href="/Admin/Education/Index" class="dash-card stat">
            <div class="stat-icon bg-teal"><i class="bi bi-mortarboard"></i></div>
            <div>
                <p class="stat-label">Eğitim</p>
                <p class="stat-value">@Model.EducationCount</p>
                <div class="stat-sub">Eğitim kaydı</div>
            </div>
        </a>

        <a href="/Admin/Message/Index" class="dash-card stat">
            <div class="stat-icon bg-indigo"><i class="bi bi-envelope"></i></div>
            <div>
                <p class="stat-label">Toplam Mesaj</p>
                <p class="stat-value">@Model.MessageCount</p>
                <div class="stat-sub">Tüm zamanlar</div>
            </div>
        </a>

        <a href="/Admin/Message/Index?status=unread" class="dash-card stat @(Model.UnreadMessageCount > 0 ? "stat-alert" : "")">
            <div class="stat-icon bg-amber"><i class="bi bi-envelope-exclamation"></i></div>
            <div>
                <p class="stat-label">Okunmamış Mesaj</p>
                <p class="stat-value">@Model.UnreadMessageCount</p>
                <div class="stat-sub">@(Model.UnreadMessageCount > 0 ? "Yanıt bekliyor" : "Hepsi okundu 🎉")</div>
            </div>
        </a>
    </div>

    <!-- ================= 2) SON 5 MESAJ ================= -->
    <div class="dash-card" style="margin-bottom:20px;">
        <h3>Son Mesajlar <a href="/Admin/Message/Index">Tümünü gör →</a></h3>

        @if (!Model.LastMessages.Any())
        {
            <div class="empty">Henüz mesaj yok.</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Gönderen</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LastMessages)
                        {
                            var detailUrl = "/Admin/Message/Index?open=" + item.MessageId;

                            <tr class="@(item.IsRead ? "" : "unread")" onclick="location.href='@detailUrl'">
                                <td>
                                    <div class="name-cell">
                                        <span class="avatar">@Initials(item.NameSurname)</span>
                                        <div>@item.NameSurname<div class="muted">@item.Email</div></div>
                                    </div>
                                </td>
                                <td><a href="@detailUrl">@item.Subject</a></td>
                                <td class="muted">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="pill pill-read">Okundu</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-unread">Okunmadı</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ================= 3) SON 3 PROJE + 4) KATEGORİ ÖZETİ ================= -->
    <div class="dash-grid dash-two">

        <div class="dash-card">
            <h3>Son Projeler <a href="/Admin/Project/Index">Tümünü gör →</a></h3>

            @if (!Model.LastProjects.Any())
            {
                <div class="empty">Henüz proje eklenmedi.</div>
            }

            @foreach (var item in Model.LastProjects)
            {
                <div class="project-row">
                    <img src="@item.CoverImageUrl" alt="@item.Title" class="project-thumb" />
                    <div class="project-info">
                        <div class="title">@item.Title</div>
                        <div class="muted">@(item.Category?.CategoryName ?? "Kategorisiz")</div>
                    </div>
                    @if (item.IsActive)
                    {
                        <span class="pill pill-active">Aktif</span>
                    }
                    else
                    {
                        <span class="pill pill-passive">Pasif</span>
                    }
                    <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="edit-link">
                        <i class="bi bi-pencil"></i> Düzenle
                    </a>
                </div>
            }
        </div>

        <div class="dash-card">
            <h3>Kategori Özeti <span class="muted">@Model.ProjectCount proje</span></h3>

            @if (!Model.CategorySummaries.Any())
            {
                <div class="empty">Henüz kategori yok.</div>
            }

            @foreach (var cat in Model.CategorySummaries)
            {
                // En kalabalık kategori %100 genişlikte, diğerleri ona oranla
                int width = maxCategory > 0 ? cat.ProjectCount * 100 / maxCategory : 0;

                <div class="cat-row">
                    <div class="cat-top">
                        <span>@cat.CategoryName</span>
                        <span>@cat.ProjectCount proje <small class="text-success">(@cat.ActiveProjectCount aktif)</small></span>
                    </div>
                    <div class="cat-track">
                        <div class="cat-fill" style="width:@(width)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ================= 5) HIZLI İŞLEMLER ================= -->
    <div class="dash-card">
        <h3>Hızlı İşlemler</h3>
        <div class="quick-actions">
            <a href="/Admin/Project/CreateProject">
                <span class="qa-icon bg-indigo"><i class="bi bi-plus-lg"></i></span>
                <span>Yeni Proje Ekle<small>Portfolyona proje ekle</small></span>
            </a>
            <a href="/Admin/Message/Index">
                <span class="qa-icon bg-amber"><i class="bi bi-inbox"></i></span>
                <span>
                    Mesajları Görüntüle
                    <small>@(Model.UnreadMessageCount > 0 ? Model.UnreadMessageCount + " okunmamış mesaj" : "Yeni mesaj yok")</small>
                </span>
            </a>
            <a href="/Default/Index/" target="_blank" rel="noopener">
                <span class="qa-icon bg-green"><i class="bi bi-box-arrow-up-right"></i></span>
                <span>Portfolyoyu Aç<small>Siteyi yeni sekmede görüntüle</small></span>
            </a>
        </div>
    </div>

</div>