@model MYAcademy_Portfolya.Entites.HeroSection
@{
    ViewData["Title"] = "Hero Section";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";  // Education'daki Layout satırının aynısını yaz
}

<style>
    .hero-preview-box {
        width: 50%;
        aspect-ratio: 4 / 5; /* dikey portre oranı */
        border: 2px dashed #ced4da;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
        transition: border-color .2s;
    }

        .hero-preview-box:hover {
            border-color: #0d6efd;
        }

        .hero-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* resmi bozmadan kutuya sığdırır */
        }

    .hero-preview-placeholder {
        text-align: center;
        color: #6c757d;
    }
</style>

<h3 class="mb-4">Hero Section</h3>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<form method="post" enctype="multipart/form-data">
    <div class="row g-4 align-items-stretch">

        <!-- SOL: Bilgi girişleri -->
        <div class="col-lg-7">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Bilgiler</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Başlık (Badge yazısı)</label>
                        <input type="text" asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Alt Başlık (İsim)</label>
                        <input type="text" asp-for="SubTitle" class="form-control" />
                        <span asp-validation-for="SubTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ: Resim seçimi -->
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Profil Resmi</div>
                <div class="card-body d-flex flex-column">

                    <!-- Kutuya tıklayınca dosya seçme penceresi açılır -->
                    <label for="imageFile" class="hero-preview-box mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img id="preview" src="@Model.ImageUrl" alt="Hero resmi" />
                            <div id="placeholder" class="hero-preview-placeholder" style="display:none;"></div>
                        }
                        else
                        {
                            <img id="preview" alt="Hero resmi" style="display:none;" />
                            <div id="placeholder" class="hero-preview-placeholder">
                                <i class="bi bi-image" style="font-size:3rem;"></i>
                                <div>Resim seçmek için tıkla</div>
                            </div>
                        }
                    </label>

                    <input type="file" id="imageFile" name="imageFile" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
                    <span asp-validation-for="ImageUrl" class="text-danger small mt-1"></span>
                    <small class="text-muted mt-2">
                        jpg, jpeg, png veya webp · en fazla 2 MB · değiştirmek istemiyorsan boş bırak.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="text-end mt-4">
        <button type="submit" class="btn btn-primary px-5">
            <i class="bi bi-save"></i> Kaydet
        </button>
    </div>
</form>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const img = document.getElementById('preview');
            img.src = URL.createObjectURL(input.files[0]);
            img.style.display = 'block';
            document.getElementById('placeholder').style.display = 'none';
        }
    }
</script>