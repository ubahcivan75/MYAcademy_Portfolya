@model List<MYAcademy_Portfolya.Entites.Project>
@{
    ViewData["Title"] = "Projeler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Projeler</h3>
    <a href="/Admin/Project/CreateProject" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Yeni Proje
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;">#</th>
                    <th style="width:140px;">Kapak</th>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>GitHub</th>
                    <th>Durum</th>
                    <th style="width:180px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz proje eklenmedi.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProjectId</td>
                        <td>
                            <img src="@item.CoverImageUrl" alt="@item.Title"
                                 style="width:120px;aspect-ratio:16/9;object-fit:cover;border-radius:6px;" />
                        </td>
                        <td class="fw-medium">@item.Title</td>
                        <td><span class="badge bg-secondary">@item.Category?.CategoryName</span></td>
                        <td>
                            <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-github"></i> Link
                            </a>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Gizli</span>
                            }
                        <td>
                            <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn btn-sm btn-success">Güncelle</a>
                                <form asp-action="DeleteProject" asp-route-id="@item.ProjectId" method="post" class="d-inline js-delete"
                                      data-message="&quot;@item.Title&quot; projesi ve kapak resmi silinecek.">
                                    <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>