@model MYAcademy_Portfolya.Entites.Project
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Yeni Proje";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .cover-preview-box {
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 2px dashed #ced4da;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
    }

        .cover-preview-box:hover {
            border-color: #283618;
        }

        .cover-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ===== Yayın durumu kutusu ===== */
    .publish-box {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 16px;
        background: #F5F4F0;
    }

    /* ===== Aktif / Pasif anahtarı ===== */
    .status-toggle {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        user-select: none;
        margin: 0;
    }

        .status-toggle input {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

    .status-slider {
        position: relative;
        width: 46px;
        height: 26px;
        background: #d1d5db;
        border-radius: 99px;
        transition: background .2s;
        flex-shrink: 0;
    }

        .status-slider::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 20px;
            height: 20px;
            background: #fff;
            border-radius: 50%;
            box-shadow: 0 1px 3px rgba(0,0,0,.2);
            transition: transform .2s;
        }

    .status-toggle input:checked + .status-slider {
        background: #10b981;
    }

        .status-toggle input:checked + .status-slider::after {
            transform: translateX(20px);
        }

    .status-toggle input:focus-visible + .status-slider {
        outline: 2px solid #283618;
        outline-offset: 2px;
    }

    .status-text {
        font-weight: 600;
    }

        .status-text .on {
            display: none;
            color: #047857;
        }

        .status-text .off {
            color: #6b7280;
        }

    .status-toggle input:checked ~ .status-text .on {
        display: inline;
    }

    .status-toggle input:checked ~ .status-text .off {
        display: none;
    }
</style>

<h3 class="mb-4">Yeni Proje Ekle</h3>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4 align-items-stretch">

        <!-- ================= SOL: Bilgiler ================= -->
        <div class="col-lg-7">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Proje Bilgileri</div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Proje Başlığı</label>
                        <input type="text" asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kategori</label>
                        <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as List<SelectListItem>)" class="form-select">
                            <option value="0">-- Kategori Seçin --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">GitHub Linki</label>
                        <input type="text" asp-for="GithubUrl" class="form-control" placeholder="https://github.com/..." />
                        <span asp-validation-for="GithubUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Yayın durumu -->
                    <div class="publish-box">
                        <label class="form-label d-block mb-2">Yayın Durumu</label>
                        <label class="status-toggle">
                            <input type="checkbox" name="IsActive" value="true" @(Model == null || Model.IsActive ? "checked" : "") />
                            <span class="status-slider"></span>
                            <span class="status-text">
                                <span class="on"><i class="bi bi-broadcast"></i> Aktif, sitede yayında</span>
                                <span class="off"><i class="bi bi-eye-slash"></i> Pasif, sitede gizli</span>
                            </span>
                        </label>
                        <input type="hidden" name="IsActive" value="false" />
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= SAĞ: Kapak resmi ================= -->
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">Kapak Resmi</div>
                <div class="card-body d-flex flex-column">

                    <label for="imageFile" class="cover-preview-box mb-3">
                        <img id="preview" style="display:none;" />
                        <div id="placeholder" class="text-center text-muted">
                            <i class="bi bi-image" style="font-size:3rem;"></i>
                            <div>Resim seçmek için tıkla</div>
                        </div>
                    </label>

                    <input type="file" id="imageFile" name="imageFile" class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
                    <span asp-validation-for="CoverImageUrl" class="text-danger small mt-1"></span>
                    <small class="text-muted mt-2">jpg, png veya webp · en fazla 2 MB · önerilen oran 16:9 (1280x720)</small>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="/Admin/Project/Index" class="btn btn-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-primary px-5">
            <i class="bi bi-save"></i> Kaydet
        </button>
    </div>
</form>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const img = document.getElementById('preview');
            img.src = URL.createObjectURL(input.files[0]);
            img.style.display = 'block';
            document.getElementById('placeholder').style.display = 'none';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}