@model List<MYAcademy_Portfolya.Entites.Education>
@{
    ViewData["Title"] = "Eğitim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}



<div class="form-card">
    <div class="form-card-header justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <div class="form-card-icon"><i class="bi bi-mortarboard"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Eğitim Bilgileri</h5>
                <small class="text-secondary">Toplam @Model.Count kayıt</small>
            </div>
        </div>
        <a asp-action="CreateEducation" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i> Yeni Ekle
        </a>
    </div>

    <div class="form-card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-secondary text-center py-5 mb-0">Henüz eğitim bilgisi eklenmedi.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Okul / Kurum</th>
                            <th>Bölüm</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsActive ? "" : "opacity-75")">
                                <td class="ps-4 fw-semibold">@item.Title</td>
                                <td>@(item.SubTitle ?? "-")</td>
                                <td class="text-nowrap">@item.Period</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-eye"></i> Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-eye-slash"></i> Pasif</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="UpdateEducation" asp-route-id="@item.EducationId" class="btn btn-soft btn-sm">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>
                                    <form asp-action="DeleteEducation" asp-route-id="@item.EducationId" method="post" class="d-inline js-delete"
                                          data-message="&quot;@item.Title&quot; eğitim bilgisi silinecek.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>