@{
    ViewData["Title"] = "CV Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<h3 class="mb-4"><i class="bi bi-file-earmark-pdf"></i> CV Yönetimi</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<div class="row g-4 align-items-stretch">

    <!-- SOL: Mevcut durum -->
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-bold">Mevcut CV</div>
            <div class="card-body d-flex flex-column">
                @if (ViewBag.CvExists == true)
                {
                    <div class="text-center py-3">
                        <i class="bi bi-file-earmark-pdf-fill text-danger" style="font-size:4rem;"></i>
                        <div class="fw-bold mt-2">cv.pdf</div>
                        <div class="text-muted small">@ViewBag.CvSize · Son güncelleme: @ViewBag.CvDate</div>
                    </div>

                    <div class="d-flex gap-2 mt-auto">
                        <a href="/Admin/Cv/Preview" target="_blank" class="btn btn-outline-primary flex-fill">
                            <i class="bi bi-eye"></i> Önizle
                        </a>
                        <form method="post" action="/Admin/Cv/Delete" class="flex-fill js-delete"
                              data-message="CV dosyasını silmek istediğine emin misin? Ana sayfadaki 'CV İndir' butonu çalışmayacak.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">
                                    
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-file-earmark-x" style="font-size:4rem;"></i>
                        <div class="mt-2">Henüz CV yüklenmedi.</div>
                        <div class="small">Ana sayfadaki "CV İndir" butonu şu an çalışmaz.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- SAĞ: Yükleme -->
    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-bold">@(ViewBag.CvExists == true ? "CV'yi Güncelle" : "CV Yükle")</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">PDF Dosyası</label>
                        <input type="file" name="cvFile" class="form-control" accept=".pdf,application/pdf" />
                    </div>

                    <ul class="small text-muted mb-4">
                        <li>Sadece <strong>PDF</strong> formatı kabul edilir.</li>
                        <li>En fazla <strong>5 MB</strong>.</li>
                        <li>Yeni dosya yüklendiğinde mevcut CV'nin yerine geçer.</li>
                    </ul>

                    <button type="submit" class="btn btn-primary px-5">
                        <i class="bi bi-upload"></i> Yükle
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>