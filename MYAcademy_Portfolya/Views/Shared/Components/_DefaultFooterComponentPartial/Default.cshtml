<!-- Footer -->
<footer>
    <div class="container">
        <div class="row g-4 align-items-center mb-5">

            <!-- Col 1: Brand -->
            <div class="col-lg-4 text-center text-lg-start">
                <a class="navbar-brand d-inline-flex align-items-center mb-2" href="#home">
                    <span class="brand-mark">ÜB</span>
                    <span class="brand-name">ÜBahçivan<span>.</span></span>
                </a>
                <p class="text-secondary small mb-0">Teknoloji, tasarım ve yaratıcılıkla geliştirildi.</p>
            </div>

            <!-- Col 2: Navigation Links -->
            <div class="col-lg-4 text-center">
                <ul class="list-inline mb-0">
                    <li class="list-inline-item mx-2"><a href="#home" class="footer-link">Ana Sayfa</a></li>
                    <li class="list-inline-item mx-2"><a href="#about" class="footer-link">Hakkımda</a></li>
                    <li class="list-inline-item mx-2"><a href="#projects" class="footer-link">Projelerim</a></li>
                    <li class="list-inline-item mx-2"><a href="#contact" class="footer-link">İletişim</a></li>
                </ul>
            </div>

            <!-- Col 3: Social Links (veritabanından) -->
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex gap-2">
                    @if (!string.IsNullOrEmpty(ViewBag.Github as string))
                    {
                        <a href="@ViewBag.Github" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                            <i class="bi bi-github"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Linkedin as string))
                    {
                        <a href="@ViewBag.Linkedin" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Mail as string))
                    {
                        <a href="mailto:@ViewBag.Mail" class="social-btn" aria-label="E-posta">
                            <i class="bi bi-envelope"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <hr class="text-secondary opacity-25 mb-4">

        <div class="text-center">
            <p class="text-secondary small mb-0">
                © @DateTime.Now.Year @ViewBag.NameSurname. Tüm hakları saklıdır.
            </p>
        </div>
    </div>
</footer>