@model List<MYAcademy_Portfolya.Entites.Project>

@{
    // Filtre butonları: sadece aktif projesi olan kategoriler
    var categories = Model
        .Where(x => x.Category != null)
        .GroupBy(x => new { x.CategoryId, x.Category.CategoryName })
        .Select(g => new
        {
            Id = g.Key.CategoryId,
            Name = g.Key.CategoryName,
            Count = g.Count()
        })
        .OrderBy(x => x.Name)
        .ToList();
}

<!-- Portfolio Projects Section -->
<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-secondary">Yakında yeni projeler burada olacak.</p>
        }
        else
        {
            <!-- Category Filter Buttons (veritabanından) -->
            <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
                <button class="filter-btn active" data-filter="all">
                    Tümü <span class="opacity-75">(@Model.Count)</span>
                </button>

                @foreach (var cat in categories)
                {
                    <button class="filter-btn" data-filter="cat-@cat.Id">
                        @cat.Name <span class="opacity-75">(@cat.Count)</span>
                    </button>
                }
            </div>

            <!-- Project Cards Grid -->
            <div class="row g-4" id="projectGrid">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 project-item" data-category="cat-@item.CategoryId">
                        <div class="project-card reveal-on-scroll">

                            <!-- Project Image -->
                            <div class="project-thumb" style="width:100%; aspect-ratio:16/9; overflow:hidden;">
                                <img src="@item.CoverImageUrl"
                                     alt="@item.Title"
                                     loading="lazy"
                                     style="width:100%; height:100%; object-fit:cover; display:block;" />
                            </div>

                            <!-- Project Content -->
                            <div class="project-body">
                                <span class="project-category-badge">@item.Category?.CategoryName</span>

                                <h3 class="project-title">@item.Title</h3>

                                <p class="project-desc">@item.Description</p>

                                <!-- Technologies -->
                                <div class="mb-3">
                                    <span class="tech-tag">ASP.NET Core</span>
                                    <span class="tech-tag">EF Core</span>
                                    <span class="tech-tag">SQL Server</span>
                                    <span class="tech-tag">Bootstrap</span>
                                </div>

                                <!-- Project Links -->
                                <div class="project-footer">
                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-link-btn">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>